{% extends 'layout.twig' %}

{% block head %}
    <title>La page d'acceuil</title>
{% endblock %}



{% block content %}

<h2>Les derniers tutoriels</h2>

<div class="row">

    {% for tutorial in tutorials %}

        <div class="col-xs col-sm-3 ">               

            <div class= "card">

                <img src="../img/test.jpg" alt="Image test" class="card-img-top" width="100%">

                <div class="card-body">
                    <h4 class="card-title">{{tutorial.name}}</h4>
                    <p class="card-text">{{tutorial.description | markdown }}</p>
                    <a href="#" class="btn btn-primary">voir plus</a>
                </div>

            </div>

        
        </div>
        
    {% endfor %}


</div>




{% endblock %}